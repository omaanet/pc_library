# Required for Neon PostgreSQL access.
DATABASE_URL=

# Vercel Web Analytics read API (server-only; never use NEXT_PUBLIC for the token).
# Enable Web Analytics for this project in the Vercel dashboard first.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Set for team-owned projects; omit for personal projects.
VERCEL_TEAM_ID=
# Hobby: leave false. Pro/Enterprise: set true and rebuild/redeploy to collect
# book views, reader opens/conversions and library/promo audio events.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS_ENABLED=false

# Public application origin, for example http://localhost:3005.
NEXT_PUBLIC_APP_URL=

# Stable server-only secret for HMAC hashing anonymous promo visitor IPs.
# Generate at least 32 random bytes (for example, 64 hexadecimal characters).
# Use a different value in each environment and do not rotate it casually.
STATS_HASH_SECRET=

# SMTP configuration.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
