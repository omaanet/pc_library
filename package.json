{
  "name": "my-app_claude",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "next dev --turbo -p 3005",
    "dev2": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3006",
    "lint": "eslint .",
    "test:previews": "tsx --test src/lib/book-preview.test.mjs",
    "check-env": "node scripts/check-env.js",
    "devENV": "node -r ./scripts/check-env.js ./node_modules/.bin/next dev --turbo -p 3005",
    "knip:json": "knip --reporter json > reports/knip.json || exit 0",
    "knip:md": "knip --reporter markdown > reports/knip.md || exit 0",
    "knip:compact": "knip --reporter compact || exit 0",
    "knip:all": "pnpm run knip:json && pnpm run knip:md && pnpm run knip:compact",
    "knip:timestamped": "node scripts/generate-knip-reports.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@mux/mux-player-react": "^3.13.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.102.8",
    "@types/color": "^4.2.1",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "immer": "^11.1.18",
    "isomorphic-dompurify": "^4.1.0",
    "lucide-react": "^0.456.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "zod": "3.24.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@shadcn/ui": "^0.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "baseline-browser-mapping": "^2.11.21",
    "dotenv": "^17.4.2",
    "eslint-config-next": "16.2.4",
    "knip": "^5.88.1",
    "postcss": "^8.5.28",
    "punycode-detector": "^1.0.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "overrides": {
    "next": {},
    "postcss": "$postcss"
  }
}
